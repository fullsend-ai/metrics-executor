PORT=7070

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# How often to re-read workflow definitions from the database (seconds).
REFRESH_INTERVAL_SECONDS=60

# Maximum run time of a single input or output transform (seconds).
SCRIPT_TIMEOUT_SECONDS=30

# Maximum run time of a whole workflow request (seconds).
REQUEST_TIMEOUT_SECONDS=300

# Maximum number of workflow executions in flight; extra requests get HTTP 503.
MAX_CONCURRENT_EXECUTIONS=32

# Comma-separated CORS allowlist. "*" allows any origin; "none" disables CORS.
CORS_ALLOWED_ORIGINS=*

# Log the caller IP address. Off by default because IP addresses are personal
# data and the address is taken from the connection, never from X-Forwarded-For.
LOG_CLIENT_IP=false

WORKFLOWS_BASE_URL=http://localhost:7070

# Dashboard (Config DB) - Read-Only access
DASHBOARD_DB_HOST=
DASHBOARD_DB_PORT=3306
DASHBOARD_DB_USER=
DASHBOARD_DB_PASSWORD=
DASHBOARD_DB_NAME=dashboard
DASHBOARD_DB_CA_PATH=

# DevLake (Data Lake DB) - Read-Only access
DEVLAKE_DB_HOST=
DEVLAKE_DB_PORT=3306
DEVLAKE_DB_USER=
DEVLAKE_DB_PASSWORD=
DEVLAKE_DB_NAME=devlake
DEVLAKE_DB_CA_PATH=